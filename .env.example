# Optional server-side contact delivery. Never use NEXT_PUBLIC_ for these.
# CONTACT_FROM must be an address on your verified Resend domain.
RESEND_API_KEY=
CONTACT_FROM=
# Public canonical origin used by social sharing metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Required server-only credentials for the site sign-in screen.
SITE_LOGIN_ID=
SITE_LOGIN_PASSWORD=
SITE_SESSION_SECRET=
